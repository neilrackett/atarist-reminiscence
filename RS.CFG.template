# RS.CFG - options for the Atari ST port of REminiscence.
#
# One name=value per line, true/1 to enable. Lines starting with #
# or ; are ignored. Every line below is shown set to the OPPOSITE of
# its default, so uncommenting a line changes that setting. The
# default is named at the end of each description.

# --- picture ------------------------------------------------------

# How the game's 224 lines meet the ST's 200-line screen. One of:
#   fit   two lines cropped at each end and one row in eleven dropped
#         between; everything is visible at a slight cost in texture
#         (default)
#   fill  in play, crop 18 lines off the top and 6 off the bottom
#         (the rooms keep their floors low and only canopy up top);
#         12 and 12 on the menu and in cutscenes. Every line shown is
#         intact, but the edges of the playfield are hidden
#   top   open the top border: all 224 lines shown natively, picture
#         on the bottom edge of a 228-line screen
#   full  open both borders: 273 lines with the picture centred.
#         Known to jump and stripe on some machines
# The two overscan modes can flicker on some hardware - a cartridge
# with resident firmware, a mouse being moved, or disk activity is
# enough - which is why a bordered mode is not the default. The title menu has a
# "Screen" line that cycles through the four for the current
# run; this line sets what it starts on. Replaces the old overscan,
# overscan_bottom and crop_screen settings, which are still read as
# top, full and fill if an older RS.CFG has them. (default: fit)
#screen=top

# Room palettes from a PALETTE\ folder beside this file, in place of
# the colours the game chooses itself: PALETTE\L1R45.HEX for level 1
# room 45, or PALETTE\L1.HEX for every room of level 1 without its
# own. Each file is 16 lines of RRGGBB hex, as Lospec and Aseprite
# export .hex palettes, each optionally listing which of the Amiga's
# 32 colours it replaces. Ctrl+P in play writes the room's current
# palette under the room's name to the game folder, to start from.
# See the README. (default: false)
#palette_custom=true

# With palette_custom, match each colour to the custom palette by hue
# rather than by nearest colour: muted greens then pick a green over
# a grey, at the cost of greys and pale colours looking noisier.
# (default: false, nearest colour)
#palette_hue=true

# --- machine ------------------------------------------------------

# Leave a Mega STE at the speed it was set to before the game ran
# (the control panel's setting), rather than switching it to 16MHz
# with the cache. Set the machine to 8MHz first and it plays at STE
# speed - for testing, not for playing. (default: true, 16MHz and
# cache on)
#megaste_speedup=false

# --- sound --------------------------------------------------------

# Play YM chip music. Needs the .STM tracks in a MUSIC\ folder beside
# this file - see the README for building them from your own disks.
# Sampled effects need an STE and play regardless of this.
# (default: false)
#music=true

# How loud the chip music plays, 0-100. The default sits it level
# with the sampled effects, which come through the STE mixer well
# below full scale - at 100 the music stood some 15dB above them.
# The chip's own volume steps are coarse, about 3dB each, so a
# change of a few points may do nothing. (default: 70)
#music_volume=100

# Use the .PRF music files rather than the .STM ones. (default: false)
#use_prf_music=true

# Turn off the STE's sampled sound entirely - nothing opens the sound
# DMA at all. Chip music (music=true) is unaffected, since that drives
# the YM instead. For diagnosing sound faults, and for anyone who
# wants the game silent. (default: true)
#ste_sound=false

# --- speed --------------------------------------------------------

# Draw every cutscene frame and let the scene run long, rather than
# dropping frames to hold its scripted pace. (default: true, hold the
# pace)
#frame_skip=false

# --- diagnostics --------------------------------------------------

# Force the CPU drawing paths and leave the BLiTTER alone. Slower - it
# exists for diagnosing timing problems. (default: true, use the
# BLiTTER where the machine has one)
#blitter=false

# Write progress and warnings to RS.LOG. Errors are always written.
# (default: false)
#logging=true

# Log the frame rate to RS.LOG, averaged over 64 frames. (default:
# false)
#log_fps=true

# Time 512 gameplay frames, log the result and QUIT. Not for playing.
# (default: false)
#bench=true

# --- convenience --------------------------------------------------

# Skip the intro sequence and go straight to the title screen.
# (default: false)
#skip_intro=true

# Cheats, for seeing the whole game rather than beating it: true turns
# them all on, or add up the ones you want - 1 monsters die in one
# hit, 2 Conrad is never hit, 4 his life never goes down. So 6 is
# invincible without the one-hit kills. (default: 0, none)
#cheats=true

# --- engine options (from upstream REminiscence) -------------------

# These default to false - uncomment one to turn it on.
#enable_password_menu=true
# Does nothing here: the language switch only runs for DOS data, and
# this port takes the Amiga set. Left in because the engine accepts it.
#enable_language_selection=true
#fade_out_palette=true
#use_text_cutscenes=true
#use_white_tshirt=true
#play_asc_cutscene=true
#play_caillou_cutscene=true
#play_metro_cutscene=true
#play_serrure_cutscene=true
#play_carte_cutscene=true
#play_gamesaved_sound=true
#order_inventory_original=true

# These default to true - uncomment one to turn it off.
#bypass_protection=false
#restore_memo_cutscene=false
